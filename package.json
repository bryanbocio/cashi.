{
  "name": "cashi",
  "version": "1.0.0",
  "description": "Aplicación de inventario y ganancias",
  "private": true,
  "scripts": {
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "npm run db:test:sql && npm run db:test:concurrency && npm run db:test:sales && npm run db:test:quotes && npm run db:test:quote-conversion && npm run db:test:credits && npm run db:test:purchases && npm run db:test:functions",
    "db:test:sql": "supabase test db",
    "db:test:concurrency": "node supabase/tests/next-doc-code.concurrent.cjs",
    "db:test:sales": "node supabase/tests/create-sale.concurrent.cjs",
    "db:test:quotes": "node supabase/tests/create-quote.concurrent.cjs",
    "db:test:quote-conversion": "node supabase/tests/convert-quote.concurrent.cjs",
    "db:test:credits": "node supabase/tests/register-payment.concurrent.cjs",
    "db:test:purchases": "node supabase/tests/receive-purchase-order.concurrent.cjs",
    "db:test:functions": "node supabase/tests/import-products.functions.mjs",
    "db:types": "supabase gen types typescript --local --schema public > app/app/types/database.ts",
    "app:dev": "npm --prefix app run dev",
    "app:typecheck": "npm --prefix app run typecheck",
    "app:build": "npm --prefix app run build",
    "app:test:auth": "npm --prefix app run test:auth",
    "app:test:business-switcher": "npm --prefix app run test:business-switcher",
    "app:test:caja": "npm --prefix app run test:caja",
    "app:test:credits": "npm --prefix app run test:credits",
    "app:test:expenses": "npm --prefix app run test:expenses",
    "app:test:inventory": "npm --prefix app run test:inventory",
    "app:test:inventory-import": "npm --prefix app run test:inventory-import",
    "app:test:onboarding": "npm --prefix app run test:onboarding",
    "app:test:purchases": "npm --prefix app run test:purchases",
    "app:test:quotes": "npm --prefix app run test:quotes",
    "app:test:settings": "npm --prefix app run test:settings",
    "app:test:session-business": "npm --prefix app run test:session-business"
  },
  "keywords": [],
